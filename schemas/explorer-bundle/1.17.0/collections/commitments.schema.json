{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://pspf.local/schemas/explorer-bundle/1.17.0/collections/commitments.schema.json",
    "title": "PSPF Explorer Commitments Collection",
    "type": "array",
    "items": {
        "type": "object",
        "required": ["id", "entityType", "schemaVersion", "title", "createdAt", "updatedAt", "sourceProduct", "recordStatus", "intendedOutcome", "scope", "accountableOwnerRef", "commitmentState", "baselineRevisions"],
        "additionalProperties": false,
        "properties": {
            "id": { "type": "string", "pattern": "^CMT-" },
            "entityType": { "const": "commitment" },
            "schemaVersion": { "const": "1.17.0" },
            "title": { "type": "string", "minLength": 1, "maxLength": 240 },
            "intendedOutcome": { "type": "string", "minLength": 1 },
            "scope": { "type": "string", "minLength": 1 },
            "accountableOwnerRef": { "type": "string", "minLength": 1 },
            "commitmentState": { "enum": ["draft", "proposed", "agreed", "superseded", "cancelled"] },
            "baselineRevisions": {
                "type": "array",
                "minItems": 1,
                "items": {
                    "type": "object",
                    "required": ["revision", "outcome", "scope", "accountableOwnerRef", "target", "acceptanceCriteria", "approvalDecisionId", "effectiveAt", "recordedAt"],
                    "additionalProperties": false,
                    "properties": {
                        "revision": { "type": "string", "minLength": 1 },
                        "outcome": { "type": "string", "minLength": 1 },
                        "scope": { "type": "string", "minLength": 1 },
                        "accountableOwnerRef": { "type": "string", "minLength": 1 },
                        "target": {
                            "oneOf": [
                                { "type": "object", "required": ["kind", "dueDate", "timeZone"], "additionalProperties": false, "properties": { "kind": { "const": "date" }, "dueDate": { "type": "string", "format": "date" }, "timeZone": { "type": "string", "minLength": 1 } } },
                                { "type": "object", "required": ["kind", "cadence", "nextReviewAt", "timeZone"], "additionalProperties": false, "properties": { "kind": { "const": "recurring" }, "cadence": { "type": "string", "minLength": 1 }, "nextReviewAt": { "type": "string", "format": "date-time" }, "timeZone": { "type": "string", "minLength": 1 } } }
                            ]
                        },
                        "acceptanceCriteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                        "approvalDecisionId": { "type": "string", "pattern": "^GDE-" },
                        "effectiveAt": { "type": "string", "format": "date-time" },
                        "recordedAt": { "type": "string", "format": "date-time" },
                        "supersedesRevision": { "type": "string", "minLength": 1 }
                    }
                }
            },
            "currentBaselineRevision": { "type": "string", "minLength": 1 },
            "driverRefs": { "type": "array", "items": { "type": "object", "required": ["strategyId", "choiceId", "revision"], "additionalProperties": false, "properties": { "strategyId": { "type": "string", "minLength": 1 }, "choiceId": { "type": "string", "minLength": 1 }, "revision": { "type": "string", "minLength": 1 } } } },
            "createdAt": { "type": "string", "format": "date-time" },
            "updatedAt": { "type": "string", "format": "date-time" },
            "sourceProduct": { "enum": ["core", "workshop", "explorer", "shop"] },
            "recordStatus": { "enum": ["active", "archived", "inactive", "deleted"] },
            "lifecycleStatus": { "enum": ["active", "superseded", "retired"] },
            "decisionDate": { "type": "string", "format": "date-time" }
        }
    }
}