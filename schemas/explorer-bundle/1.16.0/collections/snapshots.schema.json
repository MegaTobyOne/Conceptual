{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://pspf.local/schemas/explorer-bundle/1.16.0/collections/snapshots.schema.json",
    "title": "PSPF Explorer Snapshots Collection",
    "type": "array",
    "items": {
        "type": "object",
        "required": [
            "id",
            "entityType",
            "schemaVersion",
            "title",
            "createdAt",
            "updatedAt",
            "sourceProduct",
            "recordStatus",
            "snapshotType"
        ],
        "additionalProperties": false,
        "properties": {
            "id": {
                "type": "string",
                "pattern": "^SNP-"
            },
            "entityType": {
                "const": "snapshot"
            },
            "schemaVersion": {
                "const": "1.16.0"
            },
            "title": {
                "type": "string",
                "minLength": 1
            },
            "createdAt": {
                "type": "string",
                "format": "date-time"
            },
            "updatedAt": {
                "type": "string",
                "format": "date-time"
            },
            "sourceProduct": {
                "enum": [
                    "core",
                    "workshop",
                    "explorer"
                ]
            },
            "recordStatus": {
                "enum": [
                    "active",
                    "archived",
                    "inactive",
                    "deleted"
                ]
            },
            "snapshotType": {
                "enum": [
                    "checkpoint",
                    "reporting",
                    "backup",
                    "pre-migration"
                ]
            },
            "lifecycleStatus": {
                "enum": [
                    "active",
                    "superseded",
                    "retired"
                ]
            },
            "decisionDate": {
                "type": "string",
                "format": "date-time"
            },
            "metrics": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "requirementTotal",
                    "requirementMet",
                    "requirementApplicable",
                    "compliancePercentage",
                    "openRiskTotal",
                    "highOrExtremeRiskTotal",
                    "actionTotal",
                    "openActionTotal",
                    "completedActionTotal",
                    "overdueActionTotal"
                ],
                "properties": {
                    "requirementTotal": { "type": "integer", "minimum": 0 },
                    "requirementMet": { "type": "integer", "minimum": 0 },
                    "requirementApplicable": { "type": "integer", "minimum": 0 },
                    "compliancePercentage": { "type": "integer", "minimum": 0, "maximum": 100 },
                    "openRiskTotal": { "type": "integer", "minimum": 0 },
                    "highOrExtremeRiskTotal": { "type": "integer", "minimum": 0 },
                    "actionTotal": { "type": "integer", "minimum": 0 },
                    "openActionTotal": { "type": "integer", "minimum": 0 },
                    "completedActionTotal": { "type": "integer", "minimum": 0 },
                    "overdueActionTotal": { "type": "integer", "minimum": 0 }
                }
            }
        }
    }
}
