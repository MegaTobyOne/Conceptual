{
  "name": "pspf-workbench",
  "version": "1.78.0",
  "private": true,
  "type": "module",
  "description": "Browser workbench: capture, matter dossiers, issued editions and recovery, with browser-local storage and file exchange (ADR 0102, ADR 0103).",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@pspf/contracts": "workspace:*",
    "@pspf/ism-source-library": "workspace:*",
    "idb": "8.0.3",
    "lit": "3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "eslint-plugin-lit": "^2.2.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ]
}
