{
  "name": "pspf-explorer",
  "version": "1.61.0",
  "private": true,
  "type": "module",
  "description": "PSPF Explorer — friendly web surface for publication-mode review and browser-local authoring, with Core exchange round-trip (ADR 0084).",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-sample-bundles.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "generate:pspf-data": "node scripts/generate-pspf-data.mjs",
    "perf:budget": "node scripts/perf-budget.mjs"
  },
  "dependencies": {
    "@lit/context": "1.1.6",
    "@preact/signals-core": "1.14.1",
    "@pspf/brief-renderer": "workspace:*",
    "@pspf/contracts": "workspace:*",
    "@pspf/webview-shell": "workspace:*",
    "cytoscape": "3.33.3",
    "idb": "8.0.3",
    "lit": "3.3.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@pspf/reference-data": "workspace:*",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^25.6.0",
    "@types/three": "^0.185.1",
    "@vitest/coverage-v8": "^4.1.5",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-lit": "^2.2.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-unicorn": "^64.0.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ]
}
