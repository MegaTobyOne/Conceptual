{
  "name": "pspf-core",
  "displayName": "PSPF Core",
  "icon": "resources/icon.png",
  "description": "Local PSPF system of record, workspace bootstrap, validation, snapshots, and export operations.",
  "keywords": [
    "PSPF",
    "ISM",
    "protective security",
    "compliance",
    "governance",
    "GRC",
    "security"
  ],
  "version": "1.63.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MegaTobyOne/Conceptual.git",
    "directory": "packages/core"
  },
  "publisher": "tobyharvey",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.pspf/config/workspace.json",
    "workspaceContains:.pspf/core/pspf-core.db"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "PSPF Core",
      "properties": {
        "pspf.core.initialiseOnActivation": {
          "type": "boolean",
          "default": false,
          "description": "Initialise the PSPF workspace automatically when PSPF Core activates. Intended for trusted debug or dedicated PSPF workspaces."
        },
        "pspf.core.git.useSystemConfig": {
          "type": "boolean",
          "default": true,
          "description": "Use local Git config values as the default identity for PSPF Git-aligned workflows."
        },
        "pspf.core.git.userName": {
          "type": "string",
          "default": "",
          "description": "Git user name override for PSPF workflows. Leave blank to fall back to local Git config when enabled."
        },
        "pspf.core.git.userEmail": {
          "type": "string",
          "default": "",
          "description": "Git user email override for PSPF workflows. Leave blank to fall back to local Git config when enabled."
        },
        "pspf.core.git.defaultBranch": {
          "type": "string",
          "default": "main",
          "description": "Default Git branch label used by PSPF prompts and Git-aligned workflow messaging."
        }
      }
    },
    "commands": [
      {
        "command": "pspf.core.initialiseWorkspace",
        "title": "PSPF: Initialise PSPF Workspace"
      },
      {
        "command": "pspf.core.resetWorkspace",
        "title": "PSPF: Reset Workspace To Clean Baseline"
      },
      {
        "command": "pspf.core.validateWorkspace",
        "title": "PSPF: Validate Workspace"
      },
      {
        "command": "pspf.core.verifyIntegrity",
        "title": "PSPF: Verify Integrity"
      },
      {
        "command": "pspf.core.runIntegrityScan",
        "title": "PSPF: Run Integrity Scan"
      },
      {
        "command": "pspf.core.runDatasetDiagnostics",
        "title": "PSPF: Run Dataset Diagnostics"
      },
      {
        "command": "pspf.core.createSnapshot",
        "title": "PSPF: Create Snapshot"
      },
      {
        "command": "pspf.core.exportBundle",
        "title": "PSPF: Export Master Bundle"
      },
      {
        "command": "pspf.core.exportTeamShareBundle",
        "title": "PSPF: Export Team Share Bundle"
      },
      {
        "command": "pspf.core.importBundle",
        "title": "PSPF: Import Master Bundle"
      },
      {
        "command": "pspf.core.importExplorerLocalBundle",
        "title": "PSPF: Import Explorer Local Bundle"
      },
      {
        "command": "pspf.core.undoLastImport",
        "title": "PSPF: Undo Last Import"
      },
      {
        "command": "pspf.core.showWriterLock",
        "title": "PSPF: Show Writer Lock"
      },
      {
        "command": "pspf.core.recoverWriterLock",
        "title": "PSPF: Recover Writer Lock"
      },
      {
        "command": "pspf.core.openGitSettings",
        "title": "PSPF: Open Git Settings"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/build-core-extension.mjs",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@pspf/contracts": "workspace:*",
    "@pspf/ism-source-library": "workspace:*",
    "@pspf/reference-data": "workspace:*",
    "@pspf/webview-shell": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "sql.js": "^1.14.1"
  }
}
